# syntax=docker/dockerfile:1.3-labs
# hadolint global ignore=DL3008
FROM rust:1.98.1-bookworm@sha256:93ce27a88655056a51dbdd8f5f2d7ddc071c7b0070fb288a37b5a285fc83971e AS build

ENV DEBIAN_FRONTEND=noninteractive

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates-java nodejs default-jre-headless \
    && rm -rf /var/lib/apt/lists/* \
    && cargo install --locked just@1.4.0

# Install the pinned toolchain in its own layer so it survives source changes
COPY rust-toolchain.toml /opt/warpgate/
RUN cd /opt/warpgate && rustup show active-toolchain || rustup toolchain install

COPY . /opt/warpgate

# .git is not copied: `az acr build` excludes it from the upload, so the
# embedded version falls back to "unknown"

# for rust-embed determinism
ENV SOURCE_DATE_EPOCH=0

WORKDIR /opt/warpgate

# The cache mounts keep downloaded crates, npm packages and compiled crates
# between builds, so a rebuild only recompiles what changed. The target dir
# lives in the cache, so the binary is copied out of it within this step.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/root/.npm \
    --mount=type=cache,target=/opt/warpgate/target \
    just npm ci \
    && just openapi \
    && just npm run build \
    && cargo build --features mysql,postgres,rdp-openssl-tls --profile release-no-lto -j 4 \
        --config 'profile.release-no-lto.package.aws-sdk-ec2.opt-level=1' \
        --config 'profile.release-no-lto.package.aws-sdk-rds.opt-level=1' \
        --config 'profile.release-no-lto.package.aws-sdk-eks.opt-level=1' \
        --config 'profile.release-no-lto.package.aws-sdk-s3.opt-level=1' \
    && cp target/release-no-lto/warpgate /usr/local/bin/warpgate

ARG USER_ID=1000
RUN adduser warpgate --disabled-password --gecos "" --uid ${USER_ID} --home /data --shell /usr/sbin/nologin \
    && mkdir -p /data \
    && chown -R ${USER_ID}:${USER_ID} /data

FROM gcr.io/distroless/cc-debian12
LABEL maintainer=heywoodlh

COPY --from=build /etc/passwd /etc/passwd
COPY --from=build /etc/group /etc/group
COPY --from=build --chown=warpgate:warpgate /data /data
COPY --from=build /usr/local/bin/warpgate /usr/local/bin/warpgate

VOLUME /data

ENV WARPGATE_CONFIG=/data/warpgate.yaml

HEALTHCHECK CMD ["/usr/local/bin/warpgate", "healthcheck"]

ENV DOCKER=1
USER warpgate
ENTRYPOINT ["/usr/local/bin/warpgate"]
CMD ["run"]
