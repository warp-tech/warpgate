+        // Commit and drain the initial map separately so the next output can
+        // only have been produced by WireToSurface2.
+        start_frame(&mut client, 1);
+        client
+            .handle_pdu(GfxPdu::MapSurfaceToOutput(crate::pdu::MapSurfaceToOutputPdu {
