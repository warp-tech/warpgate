# Copy to `.env` to override the defaults in compose.yaml.
#
#     cp .env.example .env
#
# Both values are read ONLY during first-time setup, i.e. when ./data holds no
# warpgate.yaml yet. Afterwards they live in that file and changing them here
# does nothing.

# The address users will reach this gateway at, with no scheme and no port.
# It is baked into the URLs Warpgate generates for HTTP targets and tickets,
# so a gateway set up as `localhost` and then reached at 10.13.14.56 hands out
# links pointing back at the visitor's own machine.
#WARPGATE_EXTERNAL_HOST=localhost

# Leave this unset to have a random password generated and printed on first
# run, which is the safer default. Set it only if you need a known value.
#WARPGATE_ADMIN_PASSWORD=
